# Copy to .env (git-ignored) and fill in. Validate with: make smoke
# Never commit real keys. scripts/secret_scan.sh runs before the repo goes public.

# --- Elastic Cloud Serverless (Elasticsearch project) ---
ES_URL=https://YOUR-PROJECT.es.REGION.aws.elastic.cloud
ES_API_KEY=
KIBANA_URL=https://YOUR-PROJECT.kb.REGION.aws.elastic.cloud
# Confirm real IDs with: GET _inference/_all  (scripts/smoke_elastic.sh prints them)
ES_EMBED_INFERENCE_ID=.jina-embeddings-v3
ES_RERANK_INFERENCE_ID=.jina-reranker-v3
ES_INDEX=prior-art-v1

# --- LLM providers (OpenAI-compatible). Router order: Baseten -> OpenRouter ---
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_RPM_LIMIT=100

# --- GPTZero ---
GPTZERO_API_KEY=
# replay = never call the API (serve fixtures/cache) | live = call and cache
GPTZERO_MODE=replay
GPTZERO_INTERACTIVE_WORD_CAP=120000
GPTZERO_INVESTIGATION_WORD_CAP=230000

# --- Surprisal base model (Truss + vLLM; shared Model APIs do not return prompt-token logprobs) ---
# Powers retrieval-conditioned surprisal (AXIS 1, second instrument) and Fast-DetectGPT curvature (Voice).
# Unset = both abstain with a reason; nothing else changes. Deploy: baseten model push --dir baseten/surprisal-truss
SURPRISAL_BASE_URL=
SURPRISAL_API_KEY=
SURPRISAL_MODEL=surprisal

# --- Live sources ---
GITHUB_TOKEN=
EXA_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Actions ---
SLACK_WEBHOOK_URL=

# --- App ---
# asyncio = built-in host (always works) | jiuwen = openjiuwen agent-core host
ORCHESTRATOR=asyncio
BACKEND_PORT=8000
# POST /api/runs answers 429 while this many runs are executing; a finished run stays in memory this long
# (re-scores, actions, late SSE clients), then is served from backend/runs/<id>.jsonl like a recording.
MAX_LIVE_RUNS=4
RUN_RETENTION_S=600
NEXT_PUBLIC_API_BASE=http://localhost:8000
